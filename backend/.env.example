# Project Settings
PROJECT_NAME="CareAI"
API_V1_STR="/api/v1"

# Database Configuration (Docker network example)
# Replace 'postgres' with 'localhost' if running the backend outside of Docker
DATABASE_URL="postgresql://careai_user:careai_password@postgres:5432/careai_db"

# Redis Configuration (Docker network example)
# Replace 'redis' with 'localhost' if running the backend outside of Docker
REDIS_URL="redis://redis:6379/0"

# Storage Settings
STORAGE_PATH="/app/.storage"
MAX_UPLOAD_SIZE=10485760

# CORS Origins
BACKEND_CORS_ORIGINS='["http://localhost:3000"]'
